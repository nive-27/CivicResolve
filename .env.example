# ==============================================================================
# CivicResolve Environment Variables Configuration
# ==============================================================================

# Google Gemini API (SERVER-SIDE ONLY - NEVER PREFIX WITH NEXT_PUBLIC)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-2.5-flash"

# Firebase Client Configuration (Accessible from browser for Auth & Firestore)
# Obtain from Firebase Console > Project Settings > General > Your apps
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-app.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-app.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="your-app-id"

# Firebase Admin Service Account (SERVER-SIDE ONLY)
# Obtain from Firebase Console > Project Settings > Service accounts > Generate new private key
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
# Note: Escape newlines in private key as \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkq...YOUR_KEY...\n-----END PRIVATE KEY-----\n"

# Admin Access Configuration (Comma-separated admin emails for role checks)
ADMIN_EMAILS="admin@civicresolve.gov,cityofficer@civicresolve.gov"

# Optional: Google Maps Platform API Key (for Places Autocomplete / Interactive Pin)
# Falls back seamlessly to browser Geolocation API and manual address text if not set
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
